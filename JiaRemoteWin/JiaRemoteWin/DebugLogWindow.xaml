<Window x:Class="JiaRemoteWin.DebugLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="调试日志" Width="700" Height="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="TitleBar_MouseDown">

    <Border Background="#E51C1C1E" CornerRadius="14"
            BorderBrush="#22FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="44" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="📋 调试日志" FontSize="15" FontWeight="SemiBold"
                           Foreground="#E0E0E0" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                    <Button Content="清空" Width="56" Height="28" FontSize="12" Foreground="#999"
                            Background="#0FFFFFFF" BorderThickness="1" BorderBrush="#18FFFFFF"
                            Click="ClearBtn_Click"/>
                    <Button Content="✕" Width="30" Height="30" Margin="8,0,0,0" FontSize="13" Foreground="#888"
                            Background="#0FFFFFFF" BorderThickness="0" Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- 日志内容 -->
            <TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="#0A0A0C" Foreground="#CCCAC4" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11.5" Padding="16,10"
                     TextWrapping="NoWrap" AcceptsReturn="True"/>

            <!-- 底部状态栏 -->
            <Border Grid.Row="2" Height="32" Background="#08080A"
                    BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
                <Grid Margin="16,0,16,0">
                    <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" Foreground="#555"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="LineCountText" Text="0 行" FontSize="11" Foreground="#444"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>