<Window x:Class="JiaRemoteWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JiaRemote · Windows 主控端"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        Background="#0c0c0c"
        Foreground="White"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        Closing="Window_Closing">

    <Grid x:Name="RootGrid">
        <!-- ══════ 远程画面层 ══════ -->
        <Image x:Name="RenderPanel"
               Stretch="Uniform"
               Visibility="Collapsed"
               MouseMove="RenderPanel_MouseMove"
               MouseLeftButtonDown="RenderPanel_MouseLeftButtonDown"
               MouseLeftButtonUp="RenderPanel_MouseLeftButtonUp"
               MouseRightButtonDown="RenderPanel_MouseRightButtonDown"
               MouseRightButtonUp="RenderPanel_MouseRightButtonUp"
               MouseWheel="RenderPanel_MouseWheel"
               Focusable="True"/>

        <!-- 画面叠加参数 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,16,0"
                    x:Name="OverlayPanel" Visibility="Collapsed">
            <Border CornerRadius="12" Background="#99000000" Padding="6,3,10,3" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#0A84FF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FpsText" Text="120" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" FPS" FontFamily="Consolas" FontSize="10" Foreground="#666666" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="12" Background="#99000000" Padding="6,3,10,3" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#30D158" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LatencyText" Text="4ms" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" 延迟" FontFamily="Consolas" FontSize="10" Foreground="#666666" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="12" Background="#99000000" Padding="6,3,10,3">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="100% 无损" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 锁屏覆盖 -->
        <Border x:Name="LockOverlay"
                Background="#88FF0000" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="Ctrl+Alt 解锁" FontSize="14" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
        </Border>

        <!-- 远程画面底部控制栏 -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                x:Name="RemoteBar" Visibility="Collapsed">
            <Border CornerRadius="20" Background="#CC1C1C1E" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="LockBtn" Content="🔓" Width="36" Height="32"
                            Style="{StaticResource BarButton}" Click="LockBtn_Click"/>
                    <Rectangle Width="1" Fill="#33FFFFFF" Margin="8,0"/>
                    <Button Content="⏹ 断开" Style="{StaticResource BarButton}"
                            Foreground="#FF453A" Click="DisconnectBtn_Click"/>
                    <Rectangle Width="1" Fill="#33FFFFFF" Margin="8,0"/>
                    <Button Content="⚙" Width="36" Height="32"
                            Style="{StaticResource BarButton}" Click="SettingsBtn_Click"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ══════ 欢迎首页层 ══════ -->
        <Grid x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <!-- Logo -->
                <TextBlock Text="🖥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="JiaRemote" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="White" Margin="0,0,0,4"/>
                <TextBlock Text="Windows 主控端" FontSize="15" HorizontalAlignment="Center"
                           Foreground="#999999" Margin="0,0,0,32"/>

                <!-- 连接卡片 -->
                <Border Background="#BB1C1C1E" CornerRadius="20"
                        BorderBrush="#33FFFFFF" BorderThickness="1"
                        Padding="36,28" Width="340">
                    <StackPanel>
                        <!-- 已选中设备信息 -->
                        <TextBlock x:Name="DeviceNameText" Text="未找到 Mac 设备"
                                   FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="White" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse x:Name="DeviceDot" Width="6" Height="6" Fill="#555555" Margin="0,0,6,0"/>
                            <TextBlock x:Name="DeviceIpText" Text="请先扫描局域网"
                                       FontFamily="Consolas" FontSize="13" Foreground="#666666"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Border Background="#1C1C1E" CornerRadius="8"
                                    BorderBrush="#22FFFFFF" BorderThickness="1"
                                    Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="IP" FontSize="12" Foreground="#999999" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="ManualIpInput" Width="128"
                                             TextAlignment="Center" MaxLength="15"
                                             FontFamily="Consolas" FontSize="13"
                                             Foreground="White"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             VerticalAlignment="Center"
                                             TextChanged="ManualIpInput_TextChanged"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1C1C1E" CornerRadius="8"
                                    BorderBrush="#22FFFFFF" BorderThickness="1"
                                    Padding="10,6" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="端口" FontSize="12" Foreground="#999999" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="PortInput" Text="9527" Width="64"
                                             TextAlignment="Center" MaxLength="5"
                                             FontFamily="Consolas" FontSize="13"
                                             Foreground="White"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             VerticalAlignment="Center"
                                             PreviewTextInput="PortInput_PreviewTextInput"
                                             TextChanged="PortInput_TextChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 扫描到的设备列表 -->
                        <ItemsControl x:Name="DeviceListControl" Visibility="Collapsed" Margin="0,0,0,12"/>

                        <!-- 按钮 -->
                        <Button x:Name="ConnectBtn" Content="⚡ 连接 Mac"
                                Width="220" Height="56" HorizontalAlignment="Center"
                                Style="{StaticResource ConnectButton}" Click="ConnectBtn_Click" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="🔍" Width="46" Height="46" Style="{StaticResource CircleButton}"
                                    Click="ScanBtn_Click"/>
                            <Button Content="⚙" Width="46" Height="46" Style="{StaticResource CircleButton}"
                                    Click="SettingsBtn_Click" Margin="12,0,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusText" Text="请先扫描局域网设备"
                                   FontSize="13" Foreground="#666666"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
